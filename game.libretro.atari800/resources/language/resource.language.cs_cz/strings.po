msgstr "80sloupcový displej XEP80 (vyžaduje restart)"

msgctxt "#30048"
msgid "R-Time 8 Clock (Restart)"
msgstr "Hodiny R-Time 8 (vyžaduje restart)"

msgctxt "#30049"
