msgstr "Mostra LED 1200XL"

msgctxt "#30047"
msgid "XEP80 80-Column Display (Restart)"
msgstr "Display 80 colonne XEP80 (richiede riavvio)"

msgctxt "#30048"
msgid "R-Time 8 Clock (Restart)"
msgstr "Orologio R-Time 8 (richiede riavvio)"

